#!/bin/sh
# SharePark pre-commit guard — blocks secrets from ever entering a commit.
# Enable once per clone:  git config core.hooksPath .githooks

fail=0

# 1. local.properties must never be staged (holds sdk.dir + MAPS_API_KEY).
if git diff --cached --name-only | grep -qx "local.properties"; then
    echo "BLOCKED: local.properties is staged. It contains your Maps API key."
    echo "         Run: git restore --staged local.properties"
    fail=1
fi

# 2. No Google API key literal anywhere in staged content.
if git diff --cached -U0 | grep -qE "^\+.*AIzaSy[0-9A-Za-z_-]{33}"; then
    echo "BLOCKED: a Google API key literal (AIzaSy...) appears in staged changes."
    echo "         Read it from local.properties via BuildConfig instead."
    fail=1
fi

# 3. Common token formats.
if git diff --cached -U0 | grep -qE "^\+.*(ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{50,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)"; then
    echo "BLOCKED: a credential or private key appears in staged changes."
    fail=1
fi

# 4. Signing material.
if git diff --cached --name-only | grep -qE "\.(jks|keystore)$|^keystore\.properties$"; then
    echo "BLOCKED: signing material is staged."
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo ""
    echo "Commit aborted. Override only if you are certain: git commit --no-verify"
    exit 1
fi

exit 0
